#!/bin/sh /etc/rc.common
# procd service: LAN-facing SOCKS5 TCP forwarder to the mutated server.
#
# The LAN client speaks ordinary SOCKS5 to this listener.  socat opens a
# second TCP connection to the VPS, and the tc/eBPF program on "wan" mutates
# that leg in both directions.

START=99
STOP=10
USE_PROCD=1

CONF=/etc/s0cks5-forward.conf
PROG=/usr/bin/socat

start_service() {
	LISTEN_ADDR=127.0.0.1
	LISTEN_PORT=1080
	SERVER_ADDR=
	SERVER_PORT=1080

	[ -r "$CONF" ] && . "$CONF"

	if [ -z "$SERVER_ADDR" ]; then
		echo "s0cks5-forward: SERVER_ADDR is not set in $CONF" >&2
		return 1
	fi
	if [ ! -x "$PROG" ]; then
		echo "s0cks5-forward: $PROG missing; run: opkg install socat" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" \
		"TCP-LISTEN:${LISTEN_PORT},bind=${LISTEN_ADDR},fork,reuseaddr" \
		"TCP:${SERVER_ADDR}:${SERVER_PORT}"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}
