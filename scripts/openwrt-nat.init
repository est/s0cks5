#!/bin/sh /etc/rc.common
# Kernel-only replacement for the socat forwarder.
#
# DNAT: client -> LISTEN_ADDR:LISTEN_PORT becomes client -> SERVER:SERVER_PORT.
# SNAT: only the DNAT'd flow is masqueraded to the router's LAN address so the
#       server's replies come back through this router, where conntrack
#       reverses the DNAT.  SNAT alone would not redirect anything.

START=99
STOP=10

CONF=/etc/s0cks5-nat.conf
TABLE=s0cks5nat

start() {
	LISTEN_ADDR=
	LISTEN_PORT=1080
	SERVER_ADDR=
	SERVER_PORT=1080

	[ -r "$CONF" ] && . "$CONF"

	[ -n "$LISTEN_ADDR" ] || {
		echo "s0cks5-nat: LISTEN_ADDR is not set in $CONF" >&2
		return 1
	}
	[ -n "$SERVER_ADDR" ] || {
		echo "s0cks5-nat: SERVER_ADDR is not set in $CONF" >&2
		return 1
	}
	command -v nft >/dev/null 2>&1 || {
		echo "s0cks5-nat: nft is missing" >&2
		return 1
	}

	nft delete table ip "$TABLE" 2>/dev/null || true
	nft add table ip "$TABLE"
	nft add chain ip "$TABLE" prerouting \
		'{ type nat hook prerouting priority -110; policy accept; }'
	nft add rule ip "$TABLE" prerouting \
		ip daddr "$LISTEN_ADDR" tcp dport "$LISTEN_PORT" \
		dnat to "$SERVER_ADDR:$SERVER_PORT"
	nft add chain ip "$TABLE" postrouting \
		'{ type nat hook postrouting priority 110; policy accept; }'
	nft add rule ip "$TABLE" postrouting \
		ct status dnat ip daddr "$SERVER_ADDR" tcp dport "$SERVER_PORT" \
		masquerade
}

stop() {
	nft delete table ip "$TABLE" 2>/dev/null || true
}

status() {
	nft list table ip "$TABLE" 2>/dev/null || echo "s0cks5-nat: inactive"
}
